# ─────────────────────────────────────────────────────────────────────────────
# INTENT · Know the Intent. See the Signal. — environment template
#
# CARA PAKAI:
#   cp .env.example .env.local   ← rekomended (secret lokal, tidak di-commit)
#   (.env juga dibaca Next, tapi .env.local prioritas & konvensi secret)
#   DI VERCEL: file ini TIDAK dipakai — set env di dashboard Vercel
#   (lihat docs/DEPLOYMENT.md §1 untuk tabel kebutuhan per-var).
#
# TAG:
#   [NEXT_PUBLIC]  → tertanam ke bundle browser; AMAN untuk nilai publishable,
#                    JANGAN untuk secret apa pun.
#   [SERVER-ONLY]  → hanya dibaca di server; jangan pernah beri prefix
#                    NEXT_PUBLIC_ dan jangan diekspos ke client.
#   [OPSIONAL]     → kosong = fallback aman (demo/deterministik) tetap jalan.
#
# ATURAN KUTIP (parser dotenv Next.js):
#   • TANPA kutip  : nilai tanpa spasi/#/$ (semua nilai default di bawah ini).
#   • WAJIB kutip  : nilai mengandung spasi, '#', '$', atau spasi tepi.
#       - ada '$'  → kutip TUNGGAL  'nilai$contoh'   (literal, tidak di-expand)
#       - lainnya  → kutip ganda    "nilai # contoh"
#   • Semua nilai bawaan setup ini TIDAK butuh kutip. Kutip hanya bila password
#     DATABASE_URL/SESSION_SECRET Anda mengandung # atau $.
# ─────────────────────────────────────────────────────────────────────────────

# ── [NEXT_PUBLIC] Situs & branding ───────────────────────────────────────────
# Domain publik untuk metadataBase, sitemap, robots & URL webhook return.
# Kosong di lokal = http://localhost:3000. DI PRODUKSI WAJIB diisi domain real.
NEXT_PUBLIC_SITE_URL=

# ── [NEXT_PUBLIC] Supabase bridge (CIF locked data) ──────────────────────────
# Kedua nilai di bawah publik-by-design (publishable/anon, RLS read-only) —
# aman diisi tanpa kutip. Default sudah embed di src/lib/supabase/defaults.ts.
NEXT_PUBLIC_SUPABASE_URL=https://uqtvjerhgvwoxiejvrli.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_I1cuZB_Tehkh6N4_1LgCDg_fRXH9rfg
# Alias lama publishable key (dipakai sebagian kode lama sebagai fallback).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── [SERVER-ONLY] Supabase service role ──────────────────────────────────────
# JANGAN pernah pakai prefix NEXT_PUBLIC_ atau menaruhnya di browser:
# bypass seluruh RLS. Dipakai bridge server-side /api/data/catalog.
SUPABASE_SERVICE_ROLE_KEY=

# ── [SERVER-ONLY] Database & queue ───────────────────────────────────────────
# PostgreSQL Neon (opsional; kosong = in-memory demo store). Bila password
# mengandung # atau $ → bungkus SELURUH url dengan kutip tunggal.
DATABASE_URL=
# Upstash Redis (opsional; kosong = scheduler in-process)
REDIS_URL=

# ── [SERVER-ONLY] Secrets internal ───────────────────────────────────────────
# Generate acak alfanumerik panjang (tanpa karakter khusus = tanpa kutip).
# SESSION_SECRET: tanda tangan cookie sesi. CRON_SECRET: bearer untuk endpoint
# cron (/api/billing/watcher, /api/sentinel/run, /api/narratives/refresh).
SESSION_SECRET=
CRON_SECRET=

# ── [SERVER-ONLY] AI — Content Studio ────────────────────────────────────────
# Kosong = composer deterministik (tanpa LLM).
OPENAI_API_KEY=
CIF_MODEL=gpt-4o-mini
# [OPSIONAL] log verbose loader CIF ("1" = on)
CIF_VERBOSE=

# ── [SERVER-ONLY] AI Support "Rara" — OpenAI-compatible endpoint ─────────────
# Base url default sudah di kode; isi key bila endpoint memerlukannya.
SUPPORT_AI_BASE_URL=https://api.hcnsec.cn/
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=gpt-4o-mini

# ── [SERVER-ONLY] OAuth login ────────────────────────────────────────────────
# Sign in with Google (runbook: docs/GOOGLE-OAUTH.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X / Twitter Direct Post (opsional; UI sudah siap)
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── [SERVER-ONLY] Billing & payments — tiers Pro $49 & Ultimate $189 ─────────
# Kartu via Stripe Checkout (subscription bulanan).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal orders + capture; PAYPAL_LIVE=1 untuk live, kosong = sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_LIVE=
# [OPSIONAL] id webhook PayPal untuk verifikasi signature
# (PAYMENT.CAPTURE.COMPLETED). Kosong = dev mode (event tetap diproses + log).
PAYPAL_WEBHOOK_ID=
# Treasury USDT untuk invoice crypto (ERC-20 ETH L1 & SPL Solana).
USDT_ETH_TREASURY=
USDT_SOL_TREASURY=
# [OPSIONAL] auto-verifikasi transfer ETH on-chain via Etherscan.
ETHERSCAN_API_KEY=
# [DEV] auto-confirm pembayaran setelah N menit ("0" = instan); kosong = off.
PAYMENT_AUTOCONFIRM_MINUTES=

# ── [SERVER-ONLY] Webhook notifikasi keluar (Slack/Discord/custom) ───────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# Catatan: KYC TIDAK dipakai lagi — upgrade terbuka murni via deteksi dana
# (watcher on-chain / capture webhook). Tidak ada secret Sumsub yang needed.
